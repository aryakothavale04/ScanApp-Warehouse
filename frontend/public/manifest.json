{
  "name": "ScanApp Packing",
  "short_name": "ScanApp",
  "description": "Wholesale grocery packing checklist and barcode scanner",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f6f8f3",
  "theme_color": "#2f7d46",
  "orientation": "portrait",
  "share_target": {
    "action": "/share-invoice",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "invoice",
          "accept": [
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/store-logo.jpeg",
      "sizes": "192x192",
      "type": "image/jpeg",
      "purpose": "any"
    },
    {
      "src": "/store-logo.jpeg",
      "sizes": "512x512",
      "type": "image/jpeg",
      "purpose": "any maskable"
    }
  ]
}
